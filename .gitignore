# ── Segredos / Secrets ─────────────────────────────────────────────
# Arquivos de cofre reais NUNCA vão para o Git.
# Real vault files must NEVER be committed.
*.sigil
*.sigil.tmp
*.sigil.bak
*.sigilbak
# Exportações em texto puro / Plain-text exports
*.csv
.env
.env.*
*.pem
*.key
*.pfx

# ── Rust ───────────────────────────────────────────────────────────
target/
**/*.rs.bk
*.pdb

# ── Node / TypeScript ──────────────────────────────────────────────
node_modules/
dist/
build/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Tauri ──────────────────────────────────────────────────────────
app/src-tauri/target/
app/src-tauri/gen/schemas/
app/src-tauri/permissions/autogenerated/
app/src-tauri/WixTools/

# ── Extensão / Extension ───────────────────────────────────────────
extension/web-ext-artifacts/
*.zip
*.xpi
*.crx

# ── Editor e sistema / Editor and OS ───────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# ── Claude Code ────────────────────────────────────────────────────
# A pasta inteira fica só no computador de quem desenvolve.
# The whole folder stays only on the developer's computer.
.claude/

# Binários copiados para o instalador / Binaries copied for the installer
app/src-tauri/binaries/
