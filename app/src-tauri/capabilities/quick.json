{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "quick",
  "description": "Pop-up rápido: só buscar, desbloquear, gerar, copiar e digitar / Quick popup: only search, unlock, generate, copy and type",
  "windows": [
    "quick-*"
  ],
  "permissions": [
    "allow-unlock",
    "allow-generate-password",
    "allow-copy-field",
    "allow-quick-context",
    "allow-quick-search",
    "allow-quick-type",
    "allow-quick-save-program",
    "allow-quick-close",
    "allow-quick-offer-accept",
    "allow-quick-ignore-program"
  ]
}
