{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Janela principal: só os comandos do SigilVault e ouvir eventos do app, nenhum plugin / Main window: only SigilVault commands and listening to app events, no plugins",
  "windows": [
    "main-*"
  ],
  "permissions": [
    "allow-app-state",
    "allow-password-strength",
    "allow-create-vault",
    "allow-unlock",
    "allow-recover",
    "allow-lock",
    "allow-list-items",
    "allow-add-item",
    "allow-update-item",
    "allow-delete-item",
    "allow-reveal-password",
    "allow-reveal-notes",
    "allow-copy-field",
    "allow-copy-text",
    "allow-generate-password",
    "allow-change-master-password",
    "allow-regenerate-codes",
    "allow-save-settings",
    "allow-export-vault",
    "allow-export-csv",
    "allow-import-file",
    "allow-delete-imported-file",
    "allow-merge-vault",
    "allow-import-vault-file",
    "allow-list-backups",
    "allow-restore-backup",
    "allow-pairing-pending",
    "allow-cancel-pairing",
    "allow-list-pairings",
    "allow-remove-pairing",
    "allow-revoke-site",
    "allow-fill-log",
    "allow-reveal-history",
    "allow-health-report",
    "allow-quick-context",
    "allow-quick-search",
    "allow-quick-type",
    "allow-quick-save-program",
    "allow-quick-close",
    "allow-hotkeys-in-use",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
