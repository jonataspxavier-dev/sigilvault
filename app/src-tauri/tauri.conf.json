{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SigilVault",
  "mainBinaryName": "sigilvault-app",
  "version": "0.1.0",
  "identifier": "app.sigilvault.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node scripts/prepare-bundle.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "freezePrototype": true,
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      },
      "capabilities": [
        "main",
        "quick"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/sigilvault-host"
    ],
    "resources": {
      "native-messaging/app.sigilvault.host.chromium.json": "app.sigilvault.host.chromium.json",
      "native-messaging/app.sigilvault.host.firefox.json": "app.sigilvault.host.firefox.json",
      "../../extension/dist/chromium/": "extension/chromium/",
      "../../extension/dist/firefox/": "extension/firefox/"
    },
    "publisher": "SigilVault",
    "shortDescription": "Gerenciador de senhas local / Local password manager",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer/hooks.nsh",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
